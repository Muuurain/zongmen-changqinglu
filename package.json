{
  "name": "zongmen-changqinglu",
  "productName": "宗门长青录",
  "version": "1.1.2",
  "description": "传统仙侠宗门经营模拟游戏（v1.1.2 核心流程与存档修复版）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test scripts/game.test.js",
    "pack": "electron-builder --win --x64",
    "dist": "electron-builder --win nsis --x64",
    "build:portable": "node scripts/build-portable.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
    "build": {
      "appId": "com.zongmen.changqinglu",
      "productName": "宗门长青录",
      "icon": "build/app_icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "build/app_icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "宗门长青录"
    }
  }
}
